---
import Base from '../layouts/Base.astro';
import { getArticles } from '../lib/articles';
import { siteConfig } from '../site.config';

const articles = await getArticles();
const sorted = articles.sort((a, b) => {
	const da = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0;
	const db = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0;
	return db - da;
});

const pageSize = siteConfig.articlesPerPage;
const pageItems = sorted.slice(0, pageSize);
const lastPage = Math.ceil(sorted.length / pageSize);
const totalArticles = sorted.length;
---
<Base title={`${siteConfig.name} — Home`} isHome>
	<main>
		<section class={`welcome${siteConfig.author.photo ? '' : ' no-photo'}`}>
			{siteConfig.author.photo && (
				<div class="welcome-photo">
					<img src={siteConfig.author.photo} srcset={siteConfig.author.photoLarge ? `${siteConfig.author.photo} 600w, ${siteConfig.author.photoLarge} 1000w` : undefined} sizes="(max-width: 760px) 92vw, 480px" alt={siteConfig.author.name} width="600" height="510" fetchpriority="high" decoding="async" />
				</div>
			)}
			<div class="welcome-text">
				<div class="welcome-kicker">Welcome to my kitchen</div>
				<h2>Hi, I'm {siteConfig.author.name.split(' ')[0]}! 👋</h2>
				<Fragment set:html={siteConfig.author.welcome} />
				<div class="welcome-actions">
					<a class="welcome-btn" href={siteConfig.author.url}>Read my story</a>
					<a class="welcome-link" href="#latest">Browse recipes &darr;</a>
				</div>
			</div>
		</section>

		<h2 class="section-title" id="latest">Latest Articles ({totalArticles})</h2>
		<div class="grid">
			{pageItems.map((a, i) => (
				<div class="card">
					<a href={`/${a.id}/`}>
						{i === 0 ? (
							<img class="thumb" src={a.data.image} alt={a.data.title} onerror="this.style.display='none'" />
						) : (
							<img class="thumb" src={a.data.image} alt={a.data.title} loading="lazy" onerror="this.style.display='none'" />
						)}
						<div class="body">
							<div class="cat">{a.data.category}</div>
							<h3>{a.data.title}</h3>
							<p>{(a.data.meta ?? '').slice(0, 100)}...</p>
							<div class="card-meta">
								{siteConfig.author.avatar ? <img class="avatar-img" src={siteConfig.author.avatar} alt="" width="28" height="28" loading="lazy" /> : <span class="avatar">{siteConfig.author.name[0]}</span>}
								<span class="author-name">{a.data.author}</span>
								{a.data.pubDate && (
									<time datetime={new Date(a.data.pubDate).toISOString()}>
										{new Date(a.data.pubDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
									</time>
								)}
							</div>
						</div>
					</a>
				</div>
			))}
		</div>

		{lastPage > 1 && (
			<nav class="pagination">
				<span class="page-link disabled">&larr; Previous</span>
				<span class="page-info">Page 1 of {lastPage}</span>
				<a href="/page/2/" class="page-link">Next &rarr;</a>
			</nav>
		)}
	</main>
</Base>
