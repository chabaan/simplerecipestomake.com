---
import Base from '../../layouts/Base.astro';
import { getArticles, getRedirects, catSlug } from '../../lib/articles';
import Redirect from '../../components/Redirect.astro';
import { siteConfig } from '../../site.config';

export async function getStaticPaths() {
	const articles = await getArticles();
	const categories = [...new Set(articles.map((a) => a.data.category).filter(Boolean))] as string[];
	const redirects = await getRedirects();
	return [
		...categories.map((cat) => ({ params: { cat: catSlug(cat) }, props: { categoryName: cat } })),
		...[...redirects]
			.filter(([from]) => from.startsWith('category/'))
			.map(([from, to]) => ({ params: { cat: from.slice('category/'.length) }, props: { redirectTo: to } })),
	];
}

const { categoryName, redirectTo } = Astro.props as any;
const articles = await getArticles();
const filtered = articles
	.filter((a) => a.data.category === categoryName)
	.sort((a, b) => {
		const da = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0;
		const db = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0;
		return db - da;
	});
---
{redirectTo ? <Redirect to={redirectTo} /> : (
<Base title={`${categoryName} — Articles`}>
	<main>
		<h2 class="section-title">{categoryName} ({filtered.length})</h2>
		<div class="grid">
			{filtered.map((a) => (
				<div class="card">
					<a href={`/${a.id}/`}>
						<img class="thumb" src={a.data.image} alt={a.data.title} loading="lazy" onerror="this.style.display='none'" />
						<div class="body">
							<div class="cat">{a.data.category}</div>
							<h3>{a.data.title}</h3>
							<p>{(a.data.meta ?? '').slice(0, 100)}...</p>
							<div class="card-meta">
								{siteConfig.author.avatar ? <img class="avatar-img" src={siteConfig.author.avatar} alt="" width="28" height="28" loading="lazy" /> : <span class="avatar">{siteConfig.author.name[0]}</span>}
								<span class="author-name">{a.data.author}</span>
								{a.data.pubDate && (
									<time datetime={new Date(a.data.pubDate).toISOString()}>
										{new Date(a.data.pubDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
									</time>
								)}
							</div>
						</div>
					</a>
				</div>
			))}
		</div>
	</main>
</Base>
)}
